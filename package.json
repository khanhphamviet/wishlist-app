{
  "name": "wishlist-app",
  "version": "1.0.0",
  "description": "Custom Shopify Wishlist App - NestJS + Fastify",
  "main": "dist/firebase-entry.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prebuild": "node scripts/sync-assets.js",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "kill-port 3000 2>/dev/null; node scripts/sync-assets.js && node scripts/watch-assets.js & nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "sync-assets": "node scripts/sync-assets.js",
    "add-shop": "node scripts/add-shop.js",
    "install-all-shops": "node scripts/install-all-shops.js",
    "sign-app-proxy-request": "node scripts/sign-app-proxy-request.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky || true"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@fastify/view": "^12.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "graphql-request": "^7.1.2",
    "handlebars": "^4.7.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.0"
  }
}
