rules_version = '2';

// Firestore is only ever touched server-side via firebase-admin (the Admin
// SDK bypasses these rules). Deny all client access — this collection holds
// per-shop apiKey/apiSecret and cached access tokens.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
