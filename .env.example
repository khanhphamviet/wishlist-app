# ─── Shopify Custom App ───────────────────────────────────────────────────────
# Created in: Shopify Admin → Settings → Apps and sales channels → Develop apps

# Admin API access token (shown once after installing the custom app)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Full store URL including https:// — also used as the CORS allowed origin
SHOPIFY_STORE_URL=https://your-store.myshopify.com

# API secret key — used to verify webhook and App Proxy HMAC signatures
# Found in: API credentials tab → "API secret key"
SHOPIFY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Backend ──────────────────────────────────────────────────────────────────

# Public HTTPS URL of this backend
# Must also be set as the App Proxy URL in Shopify Admin
APP_URL=

PORT=3000
